subscription_id = "00000000-0000-0000-0000-000000000000"
tenant_id       = "00000000-0000-0000-0000-000000000000"

name                = "dimensionador-k8s"
resource_group_name = "rg-dimensionador-k8s"
location            = "East US"

# Image published by .github/workflows/build.yml on pushes to main.
# Available tags: latest, main, and sha-<short-commit-sha>.
container_image = "ghcr.io/kdvops/dimensionador-k8s:latest"
container_port  = 3000

# For a private GHCR package, provide credentials securely through variables.
# registry_server   = "ghcr.io"
# registry_username = "kdvops"
# registry_password = "..."
# Prefer TF_VAR_registry_password instead of storing the password in this file.

container_env = {
  NODE_ENV = "production"
}
